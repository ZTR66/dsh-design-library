# Build artefacts and local state — never published, never committed.

# A demonstration video, not part of the plugin. The frames alone are 1050 PNGs
# (~130 MB); the finished MP4 belongs with the release notes, not in the repo.
/video/
scripts/_video_data.json

# Fetched by scripts/fetch-video-*.ps1 from upstream repositories. Reproducible
# from those scripts, but committed deliberately: the plugin is unusable without
# them and re-fetching needs network access to nine repositories.
!data/video-styles/

# Generated by `npm run sync` from a local checkout; reproducible, so not tracked.
.sources/

# npm and dependency output.
*.tgz
node_modules/

# Editor and OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local overrides that must never reach a public repository.
.env
.env.*
*.local
