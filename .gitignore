# Build artefacts and local state — never published, never committed.

# The video project is a demonstration of this plugin, not part of it. The
# rendered frames alone are 1050 PNGs (~130 MB); the finished MP4 lives with the
# release notes, not in the package.
video/frames/
video/*.mp4
video/*.wav

# Generated by `npm run sync` from `.sources/`; reproducible, so not tracked.
.sources/

# npm output.
*.tgz
node_modules/

# Editor and OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local overrides that must never reach a public repository.
.env
.env.*
*.local
# Video tooling and its data dump are not part of the plugin. They were built to
# make a demo recording; shipping them would publish a script that reads the
# author's local `_video_data.json` and a .py toolchain nobody installing this
# package needs.
scripts/_video_data.json
video/
